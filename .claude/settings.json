{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/guard-bash.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__create_pull_request_with_copilot",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/guard-bash.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
