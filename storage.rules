rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // The single account allowed to change files, named by Firebase user ID.
    // The placeholder matches no account, so nobody can upload or delete until it is filled in.
    function ownerUid() {
      return 'REPLACE_WITH_OWNER_UID';
    }

    // Firebase user IDs are per project, so the SIT project has its own ID for the same person.
    // Each project's sign-in only ever issues that project's IDs, so listing both here is safe.
    function sitOwnerUid() {
      return 'WLkxsNcmo6MYOiWlODYiHxQVz7q2';
    }

    function isOwner() {
      return request.auth != null
        && (request.auth.uid == ownerUid() || request.auth.uid == sitOwnerUid());
    }

    // Anyone can fetch one file by its exact name; nobody can list the folder.
    // Only the owner can add or remove a file, and nothing is overwritten.
    match /images/{name} {
      allow get: if true;
      allow create: if isOwner()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/svg+xml'];
      allow delete: if isOwner();
    }

    // Every other path is refused by default.
  }
}
